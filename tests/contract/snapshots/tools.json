  "marketplace": {
    "create_proposal_draft": {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false,
        "readOnlyHint": false
      },
      "input": {
        "properties": {
          "bid_amount": {
            "description": "USD",
            "exclusiveMinimum": 0,
            "maximum": 100000,
            "title": "Bid Amount",
            "type": "number"
          },
          "cover_letter": {
            "maxLength": 5000,
            "minLength": 50,
            "title": "Cover Letter",
            "type": "string"
          },
          "idempotency_key": {
            "description": "unique key for this action; reuse it when retrying",
            "maxLength": 100,
            "minLength": 8,
            "title": "Idempotency Key",
            "type": "string"
          },
          "job_id": {
            "description": "job id, e.g. job-001",
            "pattern": "^[\\w-]{1,64}$",
            "title": "Job Id",
            "type": "string"
          },
          "screening_answers": {
            "default": [],
            "items": {
              "type": "string"
            },
            "maxItems": 10,
            "title": "Screening Answers",
            "type": "array"
          }
        },
        "required": [
          "job_id",
          "cover_letter",
          "bid_amount",
          "idempotency_key"
        ],
        "title": "create_proposal_draftArguments",
        "type": "object"
      },
      "output": {
        "$defs": {
          "Preview": {
            "properties": {
              "balance_after": {
                "title": "Balance After",
                "type": "integer"
              },
              "balance_before": {
                "title": "Balance Before",
                "type": "integer"
              },
              "connects_cost": {
                "title": "Connects Cost",
                "type": "integer"
              },
              "policy_version": {
                "title": "Policy Version",
                "type": "string"
              },
              "would_send": {
                "additionalProperties": true,
                "title": "Would Send",
                "type": "object"
              }
            },
            "required": [
              "would_send",
              "connects_cost",
              "balance_before",
              "balance_after",
              "policy_version"
            ],
            "title": "Preview",
            "type": "object"
          }
        },
        "properties": {
          "draft_id": {
            "title": "Draft Id",
            "type": "string"
          },
          "job_id": {
            "title": "Job Id",
            "type": "string"
          },
          "preview": {
            "$ref": "#/$defs/Preview"
          },
          "status": {
            "description": "draft | submitted",
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "draft_id",
          "job_id",
          "status",
          "preview"
        ],
        "title": "DraftResult",
        "type": "object"
      }
    },

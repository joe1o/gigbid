# .env.example = a template listing every setting the app needs, with NO real values.
# Copy it to a file called .env and fill in your own keys. .env is never committed.

# --- App ---
APP_ENV=development
APP_SECRET_KEY=replace_me                 # signs login sessions
TOKEN_ENCRYPTION_KEY=replace_me           # encrypts stored marketplace OAuth tokens

# --- Database (Neon free Postgres). Holds users, graph checkpoints, memory. ---
DATABASE_URL=                             # Neon pooled connection string (filled by `neon init`)
DATABASE_URL_UNPOOLED=                    # Neon direct connection (also filled by `neon init`)
NEON_BRANCH=
NEON_BRANCH_ID=
NEON_FUNCTION_HOST_SUFFIX=

# --- Marketplace ---
MARKETPLACE_MODE=gigsim                   # gigsim (our simulator) or upwork_live
GIGSIM_BASE_URL=http://localhost:8081     # where the mock marketplace runs
MCP_AUTH_TOKEN=replace_me                 # bearer token protecting our marketplace MCP server

# --- LLMs ---
MODEL_PROFILE=open                        # open (required, Groq open models) or paid (Gemini)
GROQ_API_KEY=                             # free key from console.groq.com
GEMINI_API_KEY=                           # optional, only for the paid profile

# --- Tracing (LangSmith free tier) ---
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=gigbid
